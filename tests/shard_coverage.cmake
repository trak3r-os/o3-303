# o3_303_shard_coverage: the sharded tests cover every test case, and every scenario, exactly once.
#   cmake -DEXE=<o3_303_tests> -DSHARDS="<file>:<n>;..." -DSCENARIO_SHARDS=<n> -P shard_coverage.cmake
# For each sharded source file the union of the n shares' --list-test-cases (O3SDK_TEST_SHARD=i/n) must equal the whole file's list, with no name twice;
# for the scenarios the union of the shares' O3_303_SCENARIO_LIST files must equal app/scenarios/*.txt, each once.
set(failed FALSE)

function(list_cases file shard out)
  if(shard STREQUAL "")
    unset(ENV{O3SDK_TEST_SHARD})
  else()
    set(ENV{O3SDK_TEST_SHARD} "${shard}")
  endif()
  execute_process(COMMAND ${EXE} --source-file=*${file}.cpp --list-test-cases RESULT_VARIABLE rc OUTPUT_VARIABLE text)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${file} ${shard}: --list-test-cases exited ${rc}")
  endif()
  string(REPLACE ";" "<semi>" text "${text}")
  string(REPLACE "\n" ";" text "${text}")
  set(names "")
  foreach(line IN LISTS text)
    if(NOT line MATCHES "^\\[doctest\\]|^=====|^$")
      list(APPEND names "${line}")
    endif()
  endforeach()
  list(SORT names)
  set(${out} "${names}" PARENT_SCOPE)
endfunction()

foreach(spec IN LISTS SHARDS)
  string(REPLACE ":" ";" parts "${spec}")
  list(GET parts 0 file)
  list(GET parts 1 n)
  list_cases(${file} "" whole)
  list(LENGTH whole total)
  set(union "")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    list_cases(${file} "${i}/${n}" part)
    list(LENGTH part count)
    message(STATUS "${file} shard ${i}/${n}: ${count} of ${total}")
    list(APPEND union ${part})
  endforeach()
  list(SORT union)
  if(NOT "${union}" STREQUAL "${whole}" OR total EQUAL 0)
    message(SEND_ERROR "${file}: the union of its ${n} shards is not its ${total} test cases, each once")
    set(failed TRUE)
  endif()
endforeach()

# the scenarios (the generic shard variable left by the loop above must not cut the test case away)
unset(ENV{O3SDK_TEST_SHARD})
file(GLOB scenario_files ${SCENARIO_DIR}/*.txt)
set(all "")
foreach(f IN LISTS scenario_files)
  get_filename_component(name ${f} NAME)
  list(APPEND all ${name})
endforeach()
list(SORT all)
list(LENGTH all total)
set(union "")
math(EXPR last "${SCENARIO_SHARDS} - 1")
foreach(i RANGE ${last})
  set(list_file ${CMAKE_CURRENT_BINARY_DIR}/scenario_list_${i}.txt)
  file(REMOVE ${list_file})
  set(ENV{O3_303_SCENARIO_SHARD} "${i}/${SCENARIO_SHARDS}")
  set(ENV{O3_303_SCENARIO_LIST} "${list_file}")
  execute_process(COMMAND ${EXE} --source-file=*o3_303_scenarios_test.cpp "--test-case=scenarios: every one runs*" RESULT_VARIABLE rc OUTPUT_QUIET)
  if(NOT rc EQUAL 0 OR NOT EXISTS ${list_file})
    message(SEND_ERROR "scenario shard ${i}: list mode exited ${rc}")
    set(failed TRUE)
    continue()
  endif()
  file(STRINGS ${list_file} part)
  list(LENGTH part count)
  message(STATUS "scenarios shard ${i}/${SCENARIO_SHARDS}: ${count} of ${total}")
  list(APPEND union ${part})
  file(REMOVE ${list_file})
endforeach()
list(SORT union)
if(NOT "${union}" STREQUAL "${all}" OR total EQUAL 0)
  message(SEND_ERROR "scenarios: the union of the ${SCENARIO_SHARDS} shards is not the ${total} files of app/scenarios, each once")
  set(failed TRUE)
endif()
if(failed)
  message(FATAL_ERROR "shard coverage broken")
endif()
message(STATUS "shard coverage: every test case and every scenario exactly once")
